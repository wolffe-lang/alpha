//! member: false

// start-once: one start of one unit, as the manager will start it, for the
// Linux rows: `start-once ROOT UNIT` reads ROOT as `alpha check --root ROOT`
// does, prepares UNIT's start (its conditions and facts), forks and execs
// it, waits for its readiness (fd:N) and its end, and then prints what
// happened, one line each, so its lines never interleave with the
// service's. Exit 0 when the start was tried, 1 when it could not be. A
// test tool built beside alpha (statically, for the rows' containers);
// the manager loop replaces it.
use std.process
use supervise
use unit

fn main() -> int {
    let args = env_args()
    if args.len != 2 {
        eprint("usage: start-once ROOT UNIT")
        return 2
    }
    let root = args[0]
    let name = args[1]
    var found = -1
    let set = unit.load_set(unit.load(root))
    for i in 0..set.len {
        if set[i].name == name {
            found = i
        }
    }
    if found < 0 {
        print("start-once: no unit {name}")
        return 1
    }
    let l = copy set[found]
    if !l.loaded {
        print("start-once: {name} did not pass alpha check")
        return 1
    }
    let p = supervise.prepare(root, l, 1)
    if !p.ok {
        if p.skipped {
            print("start-once: skipped: condition: {p.why}")
        } else {
            print("start-once: refused: {p.why}")
        }
        return 0
    }
    var st = supervise.start(p.plan)
    if !st.ok {
        print("start-once: cannot start: {st.why}")
        return 1
    }
    var lines = List[str]()
    let said = supervise.exec_result(mut st)
    if said == "" {
        (mut lines).push("start-once: exec ok")
    } else if said.starts_with("setup: ") {
        (mut lines).push("start-once: {said}")
    } else {
        (mut lines).push("start-once: exec failed: {said}")
    }
    if st.has_ready {
        if supervise.wait_ready(mut st) {
            (mut lines).push("start-once: ready")
        } else {
            (mut lines).push("start-once: closed descriptor {p.plan.ready_fd} without a newline")
        }
    }
    var child = process.Child { slot: st.child.slot }
    let status = process.wait_status(take child) else -999
    if status >= 0 {
        (mut lines).push("start-once: exited {status}")
    } else {
        let sig = 0 - status
        (mut lines).push("start-once: killed by signal {sig}")
    }
    for line in lines {
        print(line)
    }
    0
}
