// Format 1's schema (UNIT-1 sections 1 to 3): the format line here; the
// tables, keys and types as they are added.

/// A problem at a line, or none (line 0).
pub struct Problem {
    line: int,
    text: str,
}

/// The format line: the first key of a file is `alpha = 1`.
pub fn format_line(doc: Doc) -> Problem {
    var first_line: int = 0
    var first_key = ""
    var first_table = ""
    var first_value = Value { kind: 0, text: "", num: 0, flag: false, items: List[str]() }
    for t in doc.tables {
        for e in t.entries {
            if first_line == 0 || e.line < first_line {
                first_line = e.line
                first_key = e.key
                first_table = t.name
                first_value = copy e.value
            }
        }
    }
    if first_line == 0 {
        return Problem { line: 1, text: "a unit file starts with 'alpha = 1'" }
    }
    if first_key != "alpha" || first_table != "" {
        return Problem { line: first_line, text: "a unit file starts with 'alpha = 1'" }
    }
    if !is_integer(first_value) {
        return Problem { line: first_line, text: "'alpha' must be an integer" }
    }
    if first_value.num != 1 {
        return Problem {
            line: first_line,
            text: "format {first_value.num} is not known to this alpha",
        }
    }
    Problem { line: 0, text: "" }
}

/// One key of format 1: its table ("" for the top), its name, its type, and
/// for a key of words, the words.
pub struct Spec {
    table: str,
    key: str,
    ty: int,
    words: List[str],
}

// The types of format 1's keys.
const TY_STRING: int = 1

const TY_INTEGER: int = 2

const TY_BOOLEAN: int = 3

const TY_STRINGS: int = 4

const TY_UNITS: int = 5

const TY_DURATION: int = 6

const TY_BACKOFF: int = 7

const TY_MODE: int = 8

const TY_SIGNAL: int = 9

const TY_UNIT: int = 10

const TY_WORDS: int = 11

const TY_CALENDAR: int = 12

/// A key's value after the drop-ins: where it came from (the file's place in
/// the unit and the line) and whether it is still in the running (a value of
/// the wrong type is reported once and checked no further).
pub struct Item {
    table: str,
    key: str,
    file: int,
    line: int,
    value: Value,
    good: bool,
}

/// A table a unit holds, and where its first header is.
pub struct Seen {
    name: str,
    file: int,
    line: int,
}

fn spec(mut out: List[Spec], table: str, key: str, ty: int, words: str) {
    var w = List[str]()
    for x in words.words() {
        (mut w).push(x)
    }
    (mut out).push(Spec { table: table, key: key, ty: ty, words: w })
}

/// Every key of format 1, by table, in UNIT-1 section 2's order.
pub fn specs() -> List[Spec] {
    var s = List[Spec]()
    spec(mut s, "", "alpha", TY_INTEGER, "")
    spec(mut s, "", "description", TY_STRING, "")
    spec(mut s, "", "doc", TY_STRINGS, "")
    spec(mut s, "", "needs", TY_UNITS, "")
    spec(mut s, "", "wants", TY_UNITS, "")
    spec(mut s, "", "after", TY_UNITS, "")
    spec(mut s, "", "before", TY_UNITS, "")
    spec(mut s, "", "conflicts", TY_UNITS, "")
    spec(mut s, "", "stage", TY_WORDS, "early base network time multi-user maintenance")
    spec(mut s, "", "enable", TY_BOOLEAN, "")
    spec(mut s, "run", "exec", TY_STRINGS, "")
    spec(mut s, "run", "ready", TY_WORDS, "exec fd:3 fd:4 fd:5 fd:6 fd:7 fd:8 fd:9 exit forked")
    spec(mut s, "run", "ready_timeout", TY_DURATION, "")
    spec(mut s, "run", "pid_file", TY_STRING, "")
    spec(mut s, "run", "user", TY_STRING, "")
    spec(mut s, "run", "group", TY_STRING, "")
    spec(mut s, "run", "groups", TY_STRINGS, "")
    spec(mut s, "run", "no_new_privs", TY_BOOLEAN, "")
    spec(mut s, "run", "dir", TY_STRING, "")
    spec(mut s, "run", "env", TY_STRINGS, "")
    spec(mut s, "run", "env_file", TY_STRING, "")
    spec(mut s, "run", "umask", TY_MODE, "")
    spec(mut s, "run", "stdin", TY_WORDS, "null")
    spec(mut s, "run", "stdout", TY_WORDS, "log null console kmsg")
    spec(mut s, "run", "stderr", TY_WORDS, "stdout log null console kmsg")
    spec(mut s, "run", "restart", TY_WORDS, "on-failure always never")
    spec(mut s, "run", "backoff", TY_BACKOFF, "")
    spec(mut s, "run", "burst_count", TY_INTEGER, "")
    spec(mut s, "run", "burst_window", TY_DURATION, "")
    spec(mut s, "run", "healthy_after", TY_DURATION, "")
    spec(mut s, "run", "stop_signal", TY_SIGNAL, "")
    spec(mut s, "run", "stop_exec", TY_STRINGS, "")
    spec(mut s, "run", "stop_timeout", TY_DURATION, "")
    spec(mut s, "run", "stop_scope", TY_WORDS, "group main")
    spec(mut s, "run", "shutdown", TY_WORDS, "stop leave")
    spec(mut s, "run", "reload_signal", TY_SIGNAL, "")
    spec(mut s, "run", "reload_exec", TY_STRINGS, "")
    spec(mut s, "run", "pre", TY_STRINGS, "")
    spec(mut s, "run", "post_stop", TY_STRINGS, "")
    spec(mut s, "run", "runtime_dir", TY_STRING, "")
    spec(mut s, "run", "state_dir", TY_STRING, "")
    spec(mut s, "run", "pids_max", TY_INTEGER, "")
    spec(mut s, "run", "foreign", TY_BOOLEAN, "")
    spec(mut s, "limits", "nofile", TY_INTEGER, "")
    spec(mut s, "limits", "nproc", TY_INTEGER, "")
    spec(mut s, "limits", "core", TY_INTEGER, "")
    spec(mut s, "limits", "stack", TY_INTEGER, "")
    spec(mut s, "socket", "listen", TY_STRINGS, "")
    spec(mut s, "socket", "names", TY_STRINGS, "")
    spec(mut s, "socket", "backlog", TY_INTEGER, "")
    spec(mut s, "socket", "unix_mode", TY_MODE, "")
    spec(mut s, "socket", "unix_owner", TY_STRING, "")
    spec(mut s, "socket", "start", TY_WORDS, "on-connection now")
    spec(mut s, "timer", "unit", TY_UNIT, "")
    spec(mut s, "timer", "on_boot", TY_DURATION, "")
    spec(mut s, "timer", "every", TY_DURATION, "")
    spec(mut s, "timer", "calendar", TY_CALENDAR, "")
    spec(mut s, "timer", "zone", TY_WORDS, "utc local")
    spec(mut s, "timer", "persistent", TY_BOOLEAN, "")
    spec(mut s, "timer", "jitter", TY_DURATION, "")
    spec(mut s, "timer", "wait_for_time", TY_BOOLEAN, "")
    spec(mut s, "condition", "path_exists", TY_STRINGS, "")
    spec(mut s, "condition", "path_missing", TY_STRINGS, "")
    spec(mut s, "condition", "cmdline_has", TY_STRINGS, "")
    spec(mut s, "condition", "cmdline_lacks", TY_STRINGS, "")
    s
}

/// The schema as lines, `TABLE KEY` (`-` for the top): what tools/check-docs
/// holds against UNIT-1's tables.
pub fn schema_lines() -> List[str] {
    var out = List[str]()
    for s in specs() {
        let t = if s.table == "" then "-" else s.table
        (mut out).push("{t} {s.key}")
    }
    out
}

fn table_names() -> List[str] {
    var out = List[str]()
    for t in "run socket timer condition limits".words() {
        (mut out).push(t)
    }
    out
}

fn reserved_table_reason(name: str) -> str {
    if name == "account" {
        return "resource accounting this alpha cannot enforce yet"
    }
    if name == "path" {
        return "path triggers this alpha cannot watch yet"
    }
    if name == "device" {
        return "device triggers this alpha cannot watch yet"
    }
    if name == "log" {
        return "per-unit log limits this alpha cannot apply yet"
    }
    ""
}

fn reserved_key_reason(table: str, key: str) -> str {
    if table == "run" && key == "watchdog" {
        return "a liveness check format 1 does not define"
    }
    if table == "run" && key == "fd_store" {
        return "descriptors kept across restarts, which this alpha cannot do yet"
    }
    if table == "socket" && key == "accept" {
        return "one instance per connection, which format 1 does not define"
    }
    ""
}

fn spec_of(all: List[Spec], table: str, key: str) -> int {
    for i in 0..all.len {
        if all[i].table == table && all[i].key == key {
            return i
        }
    }
    -1
}

fn is_table(name: str) -> bool {
    for t in table_names() {
        if t == name {
            return true
        }
    }
    false
}

/// A key as findings name it: 'exec' in [run], or 'description' at the top.
pub fn key_ref(table: str, key: str) -> str {
    if table == "" {
        return "'{key}'"
    }
    "'{key}' in [{table}]"
}

fn table_ref(table: str) -> str {
    if table == "" {
        return "the top level"
    }
    "[{table}]"
}

fn lower(text: str) -> str {
    var out = List[byte]()
    for b in text.bytes() {
        let c = b as int
        if c >= 65 && c <= 90 {
            (mut out).push((c + 32) as byte)
        } else {
            (mut out).push(b)
        }
    }
    str_from_utf8(out) else |e| match e {
        utf8 => text,
    }
}

// The hint after "has no key 'K'": a case slip, another table's key, or a
// near miss, in that order.
fn key_hint(all: List[Spec], table: str, key: str) -> str {
    let low = lower(key)
    for s in all {
        if s.table == table && s.key == low && low != key {
            return " (keys are lowercase: did you mean '{s.key}'?)"
        }
    }
    for s in all {
        if s.key == key && s.table != table {
            if s.table == "" {
                return " ('{key}' belongs at the top level)"
            }
            return " ('{key}' belongs in [{s.table}])"
        }
    }
    var best = ""
    var best_d: int = 3
    for s in all {
        if s.table == table {
            let d = edit_distance(key, s.key)
            if d < best_d {
                best_d = d
                best = s.key
            }
        }
    }
    if best != "" {
        return " (did you mean '{best}'?)"
    }
    ""
}

fn table_hint(name: str) -> str {
    let low = lower(name)
    var best = ""
    var best_d: int = 3
    for t in table_names() {
        let d = if t == low then 0 else edit_distance(name, t)
        if d < best_d {
            best_d = d
            best = t
        }
    }
    if best != "" {
        return " (did you mean [{best}]?)"
    }
    " (the tables are [run], [socket], [timer], [condition] and [limits])"
}

// Step 2 for one file: every table and key known or reserved.
fn check_names(
    mut fs: Findings,
    all: List[Spec],
    name: str,
    file: int,
    path: str,
    doc: Doc,
) -> bool {
    var clean = true
    for t in doc.tables {
        if t.name != "" && !is_table(t.name) {
            let reason = reserved_table_reason(t.name)
            if reason != "" {
                add(
                    mut fs,
                    0,
                    name,
                    file,
                    path,
                    t.line,
                    false,
                    "[{t.name}] is reserved (UNIT-1 §3): {reason}",
                    involving(name),
                )
            } else {
                add(
                    mut fs,
                    0,
                    name,
                    file,
                    path,
                    t.line,
                    false,
                    "format 1 has no table [{t.name}]{table_hint(t.name)}",
                    involving(name),
                )
            }
            clean = false
            continue
        }
        for e in t.entries {
            if e.key.starts_with("x-") {
                continue
            }
            let reason = reserved_key_reason(t.name, e.key)
            if reason != "" {
                add(
                    mut fs,
                    0,
                    name,
                    file,
                    path,
                    e.line,
                    false,
                    "{key_ref(t.name, e.key)} is reserved (UNIT-1 §3): {reason}",
                    involving(name),
                )
                clean = false
            } else if spec_of(all, t.name, e.key) < 0 {
                add(
                    mut fs,
                    0,
                    name,
                    file,
                    path,
                    e.line,
                    false,
                    "{table_ref(t.name)} has no key '{e.key}'{key_hint(all, t.name, e.key)}",
                    involving(name),
                )
                clean = false
            }
        }
    }
    clean
}

// The unit's keys after its drop-ins, each key's last word winning.
fn merge(all: List[Spec], docs: List[Doc], mut items: List[Item], mut seen: List[Seen]) {
    for f in 0..docs.len {
        for t in docs[f].tables {
            if t.name != "" && !is_table(t.name) {
                continue
            }
            var known = false
            for s in seen {
                if s.name == t.name {
                    known = true
                }
            }
            if !known {
                (mut seen).push(Seen { name: t.name, file: f, line: t.line })
            }
            for e in t.entries {
                if spec_of(all, t.name, e.key) < 0 {
                    continue
                }
                let item = Item {
                    table: t.name,
                    key: e.key,
                    file: f,
                    line: e.line,
                    value: copy e.value,
                    good: true,
                }
                var at: int = -1
                for i in 0..items.len {
                    if items[i].table == t.name && items[i].key == e.key {
                        at = i
                    }
                }
                if at >= 0 {
                    items[at] = item
                } else {
                    (mut items).push(item)
                }
            }
        }
    }
}

fn type_phrase(s: Spec) -> str {
    if s.ty == TY_STRING {
        return "a string"
    }
    if s.ty == TY_INTEGER {
        return "an integer"
    }
    if s.ty == TY_BOOLEAN {
        return "true or false"
    }
    if s.ty == TY_STRINGS {
        return "an array of strings"
    }
    if s.ty == TY_UNITS {
        return "an array of unit names"
    }
    if s.ty == TY_DURATION {
        return "a duration such as \"30s\""
    }
    if s.ty == TY_BACKOFF {
        return "an array of two durations such as [\"1s\", \"300s\"]"
    }
    if s.ty == TY_MODE {
        return "a mode such as \"0644\""
    }
    if s.ty == TY_SIGNAL {
        return "a signal name such as \"TERM\""
    }
    if s.ty == TY_UNIT {
        return "a unit name"
    }
    if s.ty == TY_CALENDAR {
        return "a calendar time such as \"daily\" or \"03:00\""
    }
    words_phrase(s)
}

/// A key's words as a finding says them: "null", one of "a" or "b", one of
/// "a", "b" or "c" (ready's fd:3 to fd:9 said once).
pub fn words_phrase(s: Spec) -> str {
    var shown = List[str]()
    for w in s.words {
        if w == "fd:3" {
            (mut shown).push("\"fd:3\" to \"fd:9\"")
        } else if !w.starts_with("fd:") {
            (mut shown).push("\"{w}\"")
        }
    }
    if shown.len == 1 {
        return shown[0]
    }
    var out = "one of "
    for i in 0..shown.len {
        if i > 0 {
            out = out + (if i == shown.len - 1 then " or " else ", ")
        }
        out = out + shown[i]
    }
    out
}

fn kind_for(ty: int) -> int {
    if ty == TY_INTEGER {
        return 2
    }
    if ty == TY_BOOLEAN {
        return 3
    }
    if ty == TY_STRINGS || ty == TY_UNITS || ty == TY_BACKOFF {
        return 4
    }
    1
}

// Each value of its TOML type; foreign refused.
fn check_types(
    mut fs: Findings,
    all: List[Spec],
    name: str,
    base: int,
    paths: List[str],
    mut items: List[Item],
) -> bool {
    var clean = true
    for i in 0..items.len {
        let it = copy items[i]
        let s = copy all[spec_of(all, it.table, it.key)]
        let path = paths[it.file]
        if it.value.kind != kind_for(s.ty) {
            add(
                mut fs,
                0,
                name,
                base + it.file,
                path,
                it.line,
                false,
                "{key_ref(it.table, it.key)} must be {type_phrase(s)}",
                involving(name),
            )
            items[i].good = false
            clean = false
        } else if it.table == "run" && it.key == "foreign" && it.value.flag {
            add(
                mut fs,
                0,
                name,
                base + it.file,
                path,
                it.line,
                false,
                "'foreign' in [run] is refused: this alpha has no foreign root yet",
                involving(name),
            )
            items[i].good = false
            clean = false
        }
    }
    clean
}

// Step 3 on the merged keys: each value of its shape. A value found wrong is
// marked, so the rules across keys and units pass over it.
fn check_values(
    mut fs: Findings,
    all: List[Spec],
    name: str,
    base: int,
    paths: List[str],
    accounts: Accounts,
    mut items: List[Item],
) -> bool {
    var clean = true
    let template = name.ends_with("@")
    var foreign = false
    for it in items {
        if it.table == "run" && it.key == "foreign" && it.value.kind == 3 && it.value.flag {
            foreign = true
        }
    }
    for i in 0..items.len {
        let it = copy items[i]
        if !it.good {
            continue
        }
        let s = copy all[spec_of(all, it.table, it.key)]
        let found = value_problems(all, s, it, template, foreign, accounts, items)
        for text in found {
            add(
                mut fs,
                0,
                name,
                base + it.file,
                paths[it.file],
                it.line,
                false,
                text,
                involving(name),
            )
        }
        if found.len > 0 {
            items[i].good = false
            clean = false
        }
    }
    clean
}

fn listen_count(items: List[Item]) -> int {
    for it in items {
        if it.table == "socket" && it.key == "listen" && it.good && it.value.kind == 4 {
            return it.value.items.len
        }
    }
    -1
}

// Every problem of one value, in the words of UNIT-1 section 9.
fn value_problems(
    all: List[Spec],
    s: Spec,
    it: Item,
    template: bool,
    foreign: bool,
    accounts: Accounts,
    items: List[Item],
) -> List[str] {
    var out = List[str]()
    let k = key_ref(it.table, it.key)
    let v = it.value
    let substitutes = it.table == "" && it.key == "description" ||
        it.table == "run" && (it.key == "exec" || it.key == "user" || it.key == "dir") ||
        it.table == "socket" && it.key == "listen"
    if substitutes {
        if v.kind == 1 {
            let why = substitution_why(v.text, template)
            if why != "" {
                (mut out).push("{k}: {why}")
            }
        } else {
            for x in v.items {
                let why = substitution_why(x, template)
                if why != "" {
                    (mut out).push("{k}: {why}")
                }
            }
        }
    }
    if s.ty == TY_DURATION {
        let d = duration(v.text)
        if !d.ok {
            (mut out).push("{k}: '{v.text}' is not a duration: {d.why}")
        }
    } else if s.ty == TY_BACKOFF {
        if v.items.len != 2 {
            (mut out).push("{k} needs two durations, the first wait and the longest")
        } else {
            let a = duration(v.items[0])
            let b = duration(v.items[1])
            if !a.ok {
                (mut out).push("{k}: '{v.items[0]}' is not a duration: {a.why}")
            } else if !b.ok {
                (mut out).push("{k}: '{v.items[1]}' is not a duration: {b.why}")
            } else if a.ms > b.ms {
                (mut out).push(
                    "{k}: the first wait '{v.items[0]}' is longer than the longest '{v.items[1]}'",
                )
            }
        }
    } else if s.ty == TY_MODE {
        if !mode_ok(v.text) {
            (mut out).push("{k}: '{v.text}' is not a mode (3 or 4 octal digits, as \"0644\")")
        }
    } else if s.ty == TY_SIGNAL {
        let why = signal_why(v.text)
        if why != "" {
            (mut out).push("{k}: '{v.text}' is not a signal format 1 knows ({why})")
        }
    } else if s.ty == TY_UNIT {
        let why = name_why(v.text)
        if why != "" {
            (mut out).push("{k}: '{v.text}' is not a unit name ({why})")
        }
    } else if s.ty == TY_UNITS {
        for x in v.items {
            let why = name_why(x)
            if why != "" {
                (mut out).push("{k}: '{x}' is not a unit name ({why})")
            }
        }
    } else if s.ty == TY_WORDS {
        var known = false
        for w in s.words {
            if w == v.text {
                known = true
            }
        }
        if !known {
            (mut out).push("{k} is '{v.text}'; it must be {words_phrase(s)}")
        }
    } else if s.ty == TY_CALENDAR {
        let why = calendar_why(v.text)
        if why != "" {
            (mut out).push("{k}: '{v.text}' is not a calendar time ({why})")
        }
    } else if s.ty == TY_INTEGER {
        if (it.key == "burst_count" || it.key == "pids_max") && v.num < 1 {
            (mut out).push("{k} is {v.num}; it must be 1 or more")
        } else if it.key == "backlog" && (v.num < 1 || v.num > 65535) {
            (mut out).push("{k} is {v.num}; it must be from 1 to 65535")
        }
    }
    let path_key = it.key == "pid_file" || it.key == "dir" || it.key == "env_file"
    if path_key && !v.text.starts_with("/") {
        (mut out).push("{k}: '{v.text}' is not an absolute path")
    }
    let command = it.key == "exec" ||
        it.key == "stop_exec" ||
        it.key == "reload_exec" ||
        it.key == "pre" ||
        it.key == "post_stop"
    if command {
        if v.items.len == 0 {
            (mut out).push("{k} needs at least the program")
        } else if !v.items[0].starts_with("/") {
            (mut out).push("{k}: '{v.items[0]}' is not an absolute path")
        }
    }
    if it.key == "path_exists" || it.key == "path_missing" {
        for x in v.items {
            if !x.starts_with("/") {
                (mut out).push("{k}: '{x}' is not an absolute path")
            }
        }
    }
    if it.key == "env" {
        for x in v.items {
            if !env_ok(x) {
                (mut out).push(
                    "{k}: '{x}' is not NAME=VALUE with NAME of letters, digits and '_', not starting with a digit",
                )
            }
        }
    }
    if it.key == "listen" {
        for x in v.items {
            let why = listener_why(x)
            if why == "datagram" {
                (mut out).push("{k}: '{x}' is reserved (UNIT-1 §3): datagram listeners")
            } else if why != "" {
                (mut out).push("{k}: '{x}' is not a listener ({why})")
            }
        }
    }
    if it.key == "names" && it.table == "socket" {
        let n = listen_count(items)
        if v.items.len > 0 && n >= 0 && v.items.len != n {
            (mut out).push("{k} does not give one name to each listener")
        } else {
            for x in v.items {
                if x == "" {
                    (mut out).push("{k}: '{x}' is not a listener name (a name is not empty)")
                } else if x.contains(":") {
                    (mut out).push("{k}: '{x}' is not a listener name (a name has no ':')")
                } else if x.len > 255 {
                    (mut out).push(
                        "{k}: '{x}' is not a listener name (a name is at most 255 bytes)",
                    )
                }
            }
        }
    }
    if !foreign && !(it.table == "run" && it.key == "foreign") {
        if (it.key == "user" || it.key == "unix_owner") &&
            !v.text.contains("%i") &&
            v.text != "root" &&
            !has(accounts.users, v.text) {
            (mut out).push("{k}: '{v.text}' is not in /etc/passwd")
        }
        if it.key == "group" &&
            !v.text.contains("%i") &&
            v.text != "root" &&
            !has(accounts.groups, v.text) {
            (mut out).push("{k}: '{v.text}' is not in /etc/group")
        }
        if it.key == "groups" {
            for x in v.items {
                if !x.contains("%i") && x != "root" && !has(accounts.groups, x) {
                    (mut out).push("{k}: '{x}' is not in /etc/group")
                }
            }
        }
    }
    out
}

fn find_item(items: List[Item], table: str, key: str) -> int {
    for i in 0..items.len {
        if items[i].table == table && items[i].key == key {
            return i
        }
    }
    -1
}

fn seen_at(seen: List[Seen], name: str) -> int {
    for i in 0..seen.len {
        if seen[i].name == name {
            return i
        }
    }
    -1
}

// The format line's line in the unit file: where a finding about the whole
// unit goes.
fn format_line_of(docs: List[Doc]) -> int {
    if docs.len == 0 {
        return 1
    }
    for e in docs[0].tables[0].entries {
        if e.key == "alpha" {
            return e.line
        }
    }
    1
}

// The rules across keys (UNIT-1 section 2's last list).
fn check_rules(
    mut fs: Findings,
    name: str,
    base: int,
    paths: List[str],
    docs: List[Doc],
    items: List[Item],
    seen: List[Seen],
) -> bool {
    var clean = true
    let run = seen_at(seen, "run")
    let socket = seen_at(seen, "socket")
    let timer = seen_at(seen, "timer")
    let pid = find_item(items, "run", "pid_file")
    let ready = find_item(items, "run", "ready")
    if pid >= 0 &&
        items[pid].good &&
        (ready < 0 || items[ready].good && items[ready].value.text != "forked") {
        add(
            mut fs,
            0,
            name,
            base + items[pid].file,
            paths[items[pid].file],
            items[pid].line,
            false,
            "'pid_file' in [run] is only for ready = \"forked\"",
            involving(name),
        )
        clean = false
    }
    if run >= 0 && find_item(items, "run", "exec") < 0 {
        add(
            mut fs,
            0,
            name,
            base + seen[run].file,
            paths[seen[run].file],
            seen[run].line,
            false,
            "[run] needs exec",
            involving(name),
        )
        clean = false
    }
    if timer >= 0 &&
        find_item(items, "timer", "on_boot") < 0 &&
        find_item(items, "timer", "every") < 0 &&
        find_item(items, "timer", "calendar") < 0 {
        add(
            mut fs,
            0,
            name,
            base + seen[timer].file,
            paths[seen[timer].file],
            seen[timer].line,
            false,
            "[timer] needs on_boot, every or calendar",
            involving(name),
        )
        clean = false
    }
    if socket >= 0 && timer >= 0 {
        var second = timer
        if seen[socket].file > seen[timer].file ||
            seen[socket].file == seen[timer].file && seen[socket].line > seen[timer].line {
            second = socket
        }
        add(
            mut fs,
            0,
            name,
            base + seen[second].file,
            paths[seen[second].file],
            seen[second].line,
            false,
            "a unit holds one trigger: [socket] or [timer], not both",
            involving(name),
        )
        clean = false
    }
    if run < 0 {
        if socket >= 0 {
            add(
                mut fs,
                0,
                name,
                base + seen[socket].file,
                paths[seen[socket].file],
                seen[socket].line,
                false,
                "[socket] needs [run] in the same unit",
                involving(name),
            )
            clean = false
        } else {
            let target = find_item(items, "timer", "unit")
            var fine = false
            if target >= 0 && (!items[target].good || items[target].value.text != name) {
                fine = true
            }
            if !fine {
                if timer >= 0 {
                    add(
                        mut fs,
                        0,
                        name,
                        base + seen[timer].file,
                        paths[seen[timer].file],
                        seen[timer].line,
                        false,
                        "a unit needs [run], or a [timer] whose unit names another unit",
                        involving(name),
                    )
                } else {
                    add(
                        mut fs,
                        0,
                        name,
                        base,
                        paths[0],
                        format_line_of(docs),
                        false,
                        "a unit needs [run], or a [timer] whose unit names another unit",
                        involving(name),
                    )
                }
                clean = false
            }
        }
    }
    clean
}
