// The command line: what the words after `alpha` ask for, and the answer.
//
// `run` is a pure function from the arguments to an Outcome, so the tests
// call it on every machine (the checked machine and lupin included). For
// `alpha check` it answers what to check (`check`, `root`, `files`), and
// the entry, which may read files, does the checking.

/// What one run of alpha prints and the status it ends with, or, for a
/// well-formed `alpha check`, the root and files to check, and for a
/// well-formed `alpha manager`, its root.
pub struct Outcome {
    out: str,
    err: str,
    status: int,
    check: bool,
    manager: bool,
    root: str,
    files: List[str],
}

/// alpha's version, printed by `alpha --version`.
pub fn version() -> str {
    "0.0.0"
}

/// The usage text, printed by `alpha --help` and on a usage error.
pub fn usage() -> str {
    "usage: alpha check [--root DIR] [FILE.unit ...]\n       alpha manager [--root DIR]\n       alpha --help | --version\n\nalpha is the service manager for PAX. This version checks unit files in\nformat 1 and runs the manager, which starts the boot's units and\nsupervises them until TERM; it has no control socket yet.\n"
}

fn said(out: str, err: str, status: int) -> Outcome {
    Outcome {
        out: out,
        err: err,
        status: status,
        check: false,
        manager: false,
        root: "",
        files: List[str](),
    }
}

/// A usage error of `alpha check`, named on standard error with status 2.
pub fn check_error(text: str) -> Outcome {
    said("", "alpha: check: {text}\n", 2)
}

fn check_args(args: List[str]) -> Outcome {
    var root = "/"
    var files = List[str]()
    var i: int = 1
    while i < args.len {
        let a = args[i]
        if a == "--root" {
            if i + 1 >= args.len {
                return check_error("--root needs a directory")
            }
            root = args[i + 1]
            i += 2
            continue
        }
        if a.starts_with("-") {
            return check_error("unknown option '{a}'")
        }
        if a.ends_with(".conf") {
            return check_error("'{a}' is not a NAME.unit file (a drop-in is checked with its unit)")
        }
        if !a.ends_with(".unit") {
            return check_error("'{a}' is not a NAME.unit file")
        }
        (mut files).push(a)
        i += 1
    }
    Outcome { out: "", err: "", status: 0, check: true, manager: false, root: root, files: files }
}

fn manager_error(text: str) -> Outcome {
    said("", "alpha: manager: {text}\n", 2)
}

fn manager_args(args: List[str]) -> Outcome {
    var root = "/"
    var i: int = 1
    while i < args.len {
        let a = args[i]
        if a == "--root" {
            if i + 1 >= args.len {
                return manager_error("--root needs a directory")
            }
            root = args[i + 1]
            i += 2
            continue
        }
        if a.starts_with("-") {
            return manager_error("unknown option '{a}'")
        }
        return manager_error("takes no argument '{a}'")
    }
    Outcome {
        out: "",
        err: "",
        status: 0,
        check: false,
        manager: true,
        root: root,
        files: List[str](),
    }
}

/// The answer to `alpha ARGS...`: exit 0 for `--help` and `--version`, 2
/// for a usage error, which is named on standard error, for `check` what
/// to check, and for `manager` its root.
pub fn run(args: List[str]) -> Outcome {
    if args.len == 0 {
        return said("", usage(), 2)
    }
    let word = args[0]
    if word == "check" {
        return check_args(args)
    }
    if word == "manager" {
        return manager_args(args)
    }
    if word == "--help" || word == "--version" {
        if args.len > 1 {
            return said("", "alpha: {word} takes no argument\n", 2)
        }
        if word == "--help" {
            return said(usage(), "", 0)
        }
        return said("alpha {version()}\n", "", 0)
    }
    said("", "alpha: no command '{word}' (alpha --help lists them)\n", 2)
}
