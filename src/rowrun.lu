//! member: false

// rowrun: the driver of one Linux row, run as the row's container's only
// program under its pid-1 shell. `rowrun CASE` first proves the container:
// its own signal mask and ignores (which must be empty: a row never starts
// from a masked parent unless it says so) on standard output, and its
// capabilities on standard error (logged, not compared, since they vary
// with the container engine). Then it follows CASE/row, one directive a
// line:
//
//   block SIG          block SIG in rowrun itself (through alpha's membrane)
//   ignore SIG         ignore SIG in rowrun itself
//   manager            start `alpha manager --root CASE/in`, reading its
//                      standard error (its lines and its services' "log")
//   limit MS           how long `until` and `exit` wait (20000 ms unless
//                      the row says)
//   until TEXT         read the manager's lines until one holds TEXT (within
//                      the limit), searching all its lines so far, in any order
//   sleep MS           read the manager's lines for MS milliseconds
//   term               send TERM to the manager
//   signal UNIT SIG    send SIG to UNIT's main process, by the pid the
//                      manager's line `UNIT: pid P` or `UNIT: main pid P` gave
//   exit               wait for the manager to end (within the limit, then
//                      KILL), then print its lines and its exit status
//   quiet              print none of the manager's lines at its exit
//   zombies            `fact: zombies N`, the zombies in the container
//   alive NAME PATH    `fact: NAME yes|no`: the process whose pid PATH holds
//                      is running
//   count NAME TEXT    `fact: NAME N`: the manager's lines so far holding TEXT
//   gap A | B | MIN MAX MAX1
//                      the time from the last line holding A to the first
//                      later line holding B, as rowrun read them, within
//                      [MIN, MAX] ms, or [MIN, MAX1] on one CPU
//                      (ROWRUN_ONE_CPU=1)
//   rss-mark           remember the manager's resident memory
//   rss-check PCT      `fact: rss-growth ...`: grown by at most PCT percent
//                      since the mark
//   fd-mark            remember how many descriptors the manager holds:
//                      the fewest of 50 looks 2 ms apart, since a start in
//                      flight holds a few for a moment
//   fd-check           `fact: fd-growth none` when the fewest now are at
//                      most 2 more than at the mark, or the two counts (a
//                      descriptor kept per start would be hundreds)
//   timing             nothing here: tools/check-linux runs the row again
//                      pinned to one CPU
//   client ARGS...     run `alpha ARGS --control CASE/in/run/alpha/control`
//                      and print its output as `client: ` lines, then
//                      `fact: exit-ARGS N` (the words joined by `-`)
//   tool ARGS...       run `talk ARGS` (the word CONTROL in ARGS is the
//                      control socket's path) and print its output as
//                      `tool: ` lines, then `fact: exit-tool-ARGS N`
//   as UID client|tool ...
//                      the same, the program's ids set to UID first (the
//                      fact's name begins `exit-as-UID-`)
//   bg-start [as UID] tool ARGS...
//                      start `talk ARGS` in the background and wait for its
//                      first line that is not a fact
//   bg-stop            send it TERM, then print what it said as `bg: `
//                      lines
//
// A line a client or tool prints as `fact: NAME VALUE` is printed as it is,
// a fact of the row.
//   watch-start        start `alpha watch --format=1` in the background and
//                      wait for its first line
//   watch-stop         read what the watch printed, send it TERM, and print
//                      its lines as `watch: ` lines
//   manager-again      run a second `alpha manager` on the same root and
//                      print what it said and its exit as `again: ` lines
//
// A client's, tool's and watch's lines are printed with JSON numbers that
// change from run to run replaced: `"main_pid":P`, `"group":P` (when not 0),
// `"since_monotonic_ms":T`, `"monotonic_ms":T`,
// `"next_restart_monotonic_ms":T` (when not -1), `"since_wall":"W"`.
//
// At `exit` the manager's lines are printed with times and process ids
// replaced (`@T`, `pid P`) and grouped so that their order does not hang on
// the host: the manager's own lines first, then each unit's in byte order
// of the unit names, each group in the order the manager wrote it. Two
// kinds of line are left out, since whether they appear is the kernel's
// order and not alpha's: a group's emptiness heard before its main
// process's end (`> group-empty`), and the orphans reaped (`reaped`; the
// `count` directive counts them). Then the services' output, `service: `
// before each line. Signals go only to processes the row started. A test
// tool built beside alpha (statically, for the containers).
use std.env
use std.fs
use std.poll
use std.process
use std.signal
use std.time
use sys

struct Run {
    case: str,
    pipe: fs.File,
    open: bool,
    buf: str,
    lines: List[str],
    times: List[int],
    service: List[str],
    cursor: int,
    child: process.Child,
    has_child: bool,
    pid: int,
    quiet: bool,
    rss: int,
    fds: int,
    limit: int,
    watch: process.Child,
    watch_pid: int,
    watch_pipe: fs.File,
    watching: bool,
    watch_buf: str,
    bg_slot: int,
    bg_pid: int,
    bg_fd: int,
    bg_buf: str,
}

// What a program run to its end printed, and its exit status (-N for an end
// by signal N).
struct Ran {
    out: str,
    err: str,
    status: int,
}

fn status_field(status: str, name: str) -> str {
    for line in status.lines() {
        if line.starts_with(name + ":") {
            var words = List[str]()
            for w in line[name.len + 1..line.len].words() {
                (mut words).push(w)
            }
            return " ".join(words)
        }
    }
    "?"
}

fn signal_number(name: str) -> int {
    let names = ["HUP", "INT", "QUIT", "KILL", "USR1", "USR2", "TERM", "WINCH"]
    let numbers = [1, 2, 3, 9, 10, 12, 15, 28]
    for k in 0..names.len {
        if names[k] == name {
            return numbers[k]
        }
    }
    0
}

fn ms() -> int {
    time.monotonic_ns() / 1000000
}

fn rest_of(words: List[str], at: int) -> str {
    var parts = List[str]()
    var i = at
    while i < words.len {
        (mut parts).push(words[i])
        i += 1
    }
    " ".join(parts)
}

// One chunk of the manager's standard error, split into lines: the
// manager's (`alpha: `) are kept with their arrival time, the rest are the
// services'.
fn take_chunk(mut r: Run, chunk: str) {
    let t = ms()
    r.buf = r.buf + chunk
    var going = true
    while going {
        let nl = r.buf.find("\n") else -1
        if nl < 0 {
            going = false
        } else {
            let line = r.buf[0..nl]
            r.buf = r.buf[nl + 1..r.buf.len]
            if line.starts_with("alpha: ") {
                (mut r.lines).push(line[7..line.len])
                (mut r.times).push(t)
            } else {
                (mut r.service).push(line)
            }
        }
    }
}

// Read what the manager writes for at most `wait` ms (0: what is there
// now); false at its end of output.
fn pull(mut r: Run, wait: int) -> bool {
    if !r.open {
        return false
    }
    var w = poll.open() else |_| {
        return false
    }
    poll.add_file(mut w, fs.File { fd: r.pipe.fd }, poll.READ) else |_| {
        poll.close(take w) else |_| {}
        return false
    }
    let ev = poll.wait(mut w, 0, wait) else |_| {
        poll.close(take w) else |_| {}
        return false
    }
    poll.close(take w) else |_| {}
    if ev.ready.len == 0 {
        return true
    }
    let chunk = fs.read(mut r.pipe, 65536) else |e| match e {
        eof => "",
        io => "",
        utf8 => "",
    }
    if chunk == "" {
        r.open = false
        return false
    }
    take_chunk(mut r, chunk)
    true
}

fn start_manager(mut r: Run) {
    var c = process.command("/rows/bin/alpha")
    process.push_arg(mut c, "manager")
    process.push_arg(mut c, "--root")
    process.push_arg(mut c, r.case + "/in")
    let err = process.pipe() else |e| {
        print("rowrun: no pipe: {e}")
        return
    }
    let nul = fs.open("/dev/null") else |e| {
        print("rowrun: no /dev/null: {e}")
        return
    }
    process.set_stdin(mut c, nul)
    process.set_stdout(mut c, err.write)
    process.set_stderr(mut c, err.write)
    let child = process.start(c) else |e| {
        print("rowrun: cannot start alpha: {e}")
        return
    }
    fs.close(take err.write) else |_| {}
    var n = nul
    fs.close(take n) else |_| {}
    r.pid = process.pid(child) else 0
    r.child = child
    r.has_child = true
    r.pipe = err.read
    r.open = true
    r.buf = ""
    r.lines = List[str]()
    r.times = List[int]()
    r.service = List[str]()
    r.cursor = 0
}

fn until(mut r: Run, text: str) {
    let deadline = ms() + r.limit
    r.cursor = 0
    while true {
        while r.cursor < r.lines.len {
            let hit = r.lines[r.cursor].contains(text)
            r.cursor += 1
            if hit {
                return
            }
        }
        let left = deadline - ms()
        if left <= 0 || !pull(mut r, left) {
            print("rowrun: no line holding '{text}' within {r.limit} ms")
            return
        }
    }
}

fn sleep_reading(mut r: Run, wait: int) {
    let deadline = ms() + wait
    while ms() < deadline {
        let left = deadline - ms()
        if left > 0 && !pull(mut r, left) {
            time.sleep(time.millis(left))
        }
    }
}

// The pid in the latest `UNIT: pid P` or `UNIT: main pid P` line.
fn pid_of(r: Run, name: str) -> int {
    var pid = 0
    for line in r.lines {
        let words = line.split(" ")
        if words.len >= 4 && words[1] == name + ":" && words[2] == "pid" {
            pid = words[3].to_int() else 0
        }
        if words.len >= 5 && words[1] == name + ":" && words[2] == "main" && words[3] == "pid" {
            pid = words[4].to_int() else 0
        }
    }
    pid
}

// Replace every number after `@`, and after the words pid, group and
// reaped, so a line reads the same on every run.
fn normal(line: str) -> str {
    let words = line.split(" ")
    var out = List[str]()
    var prev = ""
    for k in 0..words.len {
        var w = words[k]
        if k == 0 && w.starts_with("@") {
            prev = w
            continue
        }
        if w.starts_with("@") && w.len > 1 {
            let n = w[1..w.len].to_int() else -1
            if n >= 0 {
                w = "@T"
            } else {
                let close = w.find(")") else -1
                if close > 1 {
                    let m = w[1..close].to_int() else -1
                    if m >= 0 {
                        w = "@T" + w[close..w.len]
                    }
                }
            }
        }
        if prev == "pid" || prev == "group" || prev == "reaped" {
            let n = w.to_int() else -1
            if n >= 0 {
                w = "P"
            }
        }
        prev = words[k]
        (mut out).push(w)
    }
    " ".join(out)
}

// The unit a manager line is about, or "" for the manager's own.
fn unit_of(line: str) -> str {
    let words = line.split(" ")
    if words.len >= 3 && words[0] == ">" {
        return words[2]
    }
    if words.len >= 1 && words[0].ends_with(":") {
        return words[0][0..words[0].len - 1]
    }
    ""
}

fn shown(line: str) -> bool {
    !(line.starts_with("> group-empty ") || line.starts_with("reaped "))
}

fn sorted(xs: List[str]) -> List[str] {
    var out = List[str]()
    for x in xs {
        var at = out.len
        for j in 0..out.len {
            if at == out.len && x < out[j] {
                at = j
            }
        }
        var next = List[str]()
        for j in 0..out.len {
            if j == at {
                (mut next).push(x)
            }
            (mut next).push(out[j])
        }
        if at == out.len {
            (mut next).push(x)
        }
        out = next
    }
    out
}

fn print_lines(r: Run) {
    var lines = List[str]()
    var names = List[str]()
    for raw in r.lines {
        let line = normal(raw)
        if !shown(line) {
            continue
        }
        (mut lines).push(line)
        let u = unit_of(line)
        if u != "" {
            var seen = false
            for n in names {
                if n == u {
                    seen = true
                }
            }
            if !seen {
                (mut names).push(u)
            }
        }
    }
    for line in lines {
        if unit_of(line) == "" {
            print(line)
        }
    }
    for n in sorted(names) {
        for line in lines {
            if unit_of(line) == n {
                print(line)
            }
        }
    }
    for line in r.service {
        print("service: {line}")
    }
}

fn wait_exit(mut r: Run) {
    if !r.has_child {
        print("rowrun: no manager to wait for")
        return
    }
    let deadline = ms() + r.limit
    var status = -999
    var ended = false
    var killed = false
    while !ended {
        let c = process.poll() else |_| {
            break
        }
        if c.changed && c.child.slot == r.child.slot {
            status = c.status.value
            ended = true
        } else if ms() > deadline && !killed {
            signal.send(r.pid, signal.kill()) else |_| {}
            killed = true
            print("rowrun: the manager did not end within {r.limit} ms; sent KILL")
        } else if !pull(mut r, 50) {
            time.sleep(time.millis(20))
        }
    }
    // What it wrote before it ended is in the pipe; a service it left
    // running may hold the pipe open, so read for a moment, not to its end.
    let until_ms = ms() + 200
    while r.open && ms() < until_ms {
        if !pull(mut r, 20) {
            break
        }
    }
    r.has_child = false
    if !r.quiet {
        print_lines(r)
    }
    if status >= 0 {
        print("rowrun: manager exit {status}")
    } else {
        print("rowrun: manager killed by signal {0 - status}")
    }
    var f = fs.File { fd: r.pipe.fd }
    fs.close(take f) else |_| {}
    r.open = false
}

fn zombies() -> int {
    var n = 0
    let names = fs.read_dir("/proc") else List[str]()
    for name in names {
        let pid = name.to_int() else -1
        if pid > 0 {
            if state_of(pid) == "Z" {
                n += 1
            }
        }
    }
    n
}

fn running(path: str) -> str {
    let text = fs.read_text(path) else |_| {
        return "no"
    }
    var pid = 0
    for w in text.words() {
        pid = w.to_int() else 0
    }
    if pid <= 1 {
        return "no"
    }
    let st = state_of(pid)
    if st == "" || st == "Z" {
        return "no"
    }
    "yes"
}

// The state letter of /proc/PID/stat, or "" when there is no such process.
fn state_of(pid: int) -> str {
    let stat = fs.read_text("/proc/{pid}/stat") else |_| {
        return ""
    }
    let close = stat.rfind(")") else -1
    if close < 0 {
        return ""
    }
    for w in stat[close + 1..stat.len].words() {
        return w
    }
    ""
}

fn fds_of(pid: int) -> int {
    let names = fs.read_dir("/proc/{pid}/fd") else List[str]()
    names.len
}

fn fewest_fds(mut r: Run) -> int {
    let pid = r.pid
    var least = fds_of(pid)
    for _k in 0..49 {
        sleep_reading(mut r, 2)
        let n = fds_of(pid)
        if n < least {
            least = n
        }
    }
    least
}

fn rss_of(pid: int) -> int {
    let status = fs.read_text("/proc/{pid}/status") else ""
    let v = status_field(status, "VmRSS")
    let w = v.split(" ")
    w[0].to_int() else 0
}

fn gap(r: Run, spec: str) {
    let parts = spec.split(" | ")
    if parts.len != 3 {
        print("rowrun: gap needs 'A | B | MIN MAX MAX1'")
        return
    }
    let nums = parts[2].split(" ")
    let lo = nums[0].to_int() else 0
    var hi = 0
    if nums.len > 1 {
        hi = nums[1].to_int() else 0
    }
    var hi1 = hi
    if nums.len > 2 {
        hi1 = nums[2].to_int() else hi
    }
    let one = (env.get("ROWRUN_ONE_CPU") else "") == "1"
    let top = if one then hi1 else hi
    var b = -1
    for k in 0..r.lines.len {
        if b < 0 && r.lines[k].contains(parts[1]) {
            b = k
        }
    }
    var a = -1
    for k in 0..r.lines.len {
        if b >= 0 && k < b && r.lines[k].contains(parts[0]) {
            a = k
        }
    }
    if a < 0 || b < 0 {
        print("rowrun: gap '{parts[0]}' to '{parts[1]}': no such lines")
        return
    }
    let d = r.times[b] - r.times[a]
    if d >= lo && d <= top {
        print("rowrun: gap '{parts[0]}' to '{parts[1]}' in its window")
    } else {
        print("rowrun: gap '{parts[0]}' to '{parts[1]}' is {d} ms, outside [{lo}, {top}]")
    }
}

// The bytes `fd` holds now, or within `wait` ms; "" at its end, and `open`
// false.
fn read_ready(fd: int, wait: int) -> (bool, str) {
    var w = poll.open() else |_| {
        return (false, "")
    }
    poll.add_file(mut w, fs.File { fd: fd }, poll.READ) else |_| {
        poll.close(take w) else |_| {}
        return (false, "")
    }
    let ev = poll.wait(mut w, 0, wait) else |_| {
        poll.close(take w) else |_| {}
        return (false, "")
    }
    poll.close(take w) else |_| {}
    if ev.ready.len == 0 {
        return (true, "")
    }
    var f = fs.File { fd: fd }
    let chunk = fs.read(mut f, 65536) else |e| match e {
        eof => "",
        io => "",
        utf8 => "",
    }
    if chunk == "" {
        return (false, "")
    }
    (true, chunk)
}

// Run `argv` (its ids set to `uid` first when it is 0 or more) with no
// input, read its standard output and error to their ends, and wait for
// it; past the row's limit it is sent KILL. The manager's lines are read
// meanwhile, so the manager never waits on its own standard error.
fn run_cmd(mut r: Run, argv: List[str], uid: int) -> Ran {
    let limit = r.limit
    let o = process.pipe() else |e| {
        return Ran { out: "", err: "rowrun: no pipe: {e}", status: -999 }
    }
    let e = process.pipe() else |x| {
        return Ran { out: "", err: "rowrun: no pipe: {x}", status: -999 }
    }
    let nul = fs.open("/dev/null") else |x| {
        return Ran { out: "", err: "rowrun: no /dev/null: {x}", status: -999 }
    }
    var c = process.from_argv(argv)
    process.set_fd(mut c, 0, nul)
    process.set_fd(mut c, 1, o.write)
    process.set_fd(mut c, 2, e.write)
    let f = process.fork() else |x| {
        return Ran { out: "", err: "rowrun: cannot fork: {x}", status: -999 }
    }
    if process.is_child(f) {
        if uid >= 0 {
            process.set_ids(uid, uid, [uid]) else |_| {
                process.exit(125)
            }
        }
        process.exec(c, ["PATH=/usr/bin:/bin", "HOME=/tmp", "SHELL=/bin/sh"]) else |_| {}
        process.exit(127)
    }
    var ow = o.write
    fs.close(take ow) else |_| {}
    var ew = e.write
    fs.close(take ew) else |_| {}
    var n = nul
    fs.close(take n) else |_| {}
    var out = ""
    var err = ""
    var o_open = true
    var e_open = true
    let deadline = ms() + limit
    var killed = false
    while o_open || e_open {
        if r.open {
            let _more = pull(mut r, 0)
        }
        if ms() > deadline && !killed {
            signal.send(f.pid, signal.kill()) else |_| {}
            killed = true
        }
        if o_open {
            let (more, chunk) = read_ready(o.read.fd, 20)
            o_open = more
            out = out + chunk
        }
        if e_open {
            let (more, chunk) = read_ready(e.read.fd, 20)
            e_open = more
            err = err + chunk
        }
    }
    var orf = o.read
    fs.close(take orf) else |_| {}
    var erf = e.read
    fs.close(take erf) else |_| {}
    var ch = process.Child { slot: f.child.slot }
    let status = process.wait_status(take ch) else -999
    if killed {
        err = err + "rowrun: it did not end within {limit} ms; sent KILL\n"
    }
    Ran { out: out, err: err, status: status }
}

// The JSON numbers a run changes, replaced (the header lists them).
fn normal_json(line: str) -> str {
    var out = line
    let keys = [
        "main_pid",
        "group",
        "since_monotonic_ms",
        "monotonic_ms",
        "next_restart_monotonic_ms",
    ]
    let marks = ["P", "P", "T", "T", "T"]
    for k in 0..keys.len {
        out = replace_number(out, "\"{keys[k]}\":", marks[k])
    }
    let wall = "\"since_wall\":\""
    var at = out.find(wall) else -1
    while at >= 0 {
        let start = at + wall.len
        let close = out[start..out.len].find("\"") else -1
        if close < 0 {
            break
        }
        out = out[0..start] + "W" + out[start + close..out.len]
        let next = out[start + 1..out.len].find(wall) else -1
        at = if next < 0 then -1 else start + 1 + next
    }
    out
}

// Every number after `key` replaced by `mark`, but -1 (none) kept, and 0
// (none) kept for a pid or a group (`mark` P).
fn replace_number(line: str, key: str, mark: str) -> str {
    var out = ""
    var rest = line
    var going = true
    while going {
        let at = rest.find(key) else -1
        if at < 0 {
            going = false
        } else {
            let start = at + key.len
            var end = start
            let b = rest.bytes()
            while end < rest.len &&
                (b[end] == 45 as byte || b[end] >= 48 as byte && b[end] <= 57 as byte) {
                end += 1
            }
            let num = rest[start..end]
            let kept = num == "-1" || num == "" || num == "0" && mark == "P"
            out = out + rest[0..start] + (if kept then num else mark)
            rest = rest[end..rest.len]
        }
    }
    out + rest
}

fn normal_any(line: str) -> str {
    if line.starts_with("{{") || line.contains(" {{") {
        return normal_json(line)
    }
    normal(line)
}

fn fact_name(prefix: str, words: List[str], from: int) -> str {
    var parts = List[str]()
    for k in from..words.len {
        let x = words[k]
        if x == "--format=1" {
            (mut parts).push("format1")
        } else if x.starts_with("{{") {
            (mut parts).push("line")
        } else {
            (mut parts).push(x)
        }
    }
    prefix + "-".join(parts)
}

fn control_path(r: Run) -> str {
    r.case + "/in/run/alpha/control"
}

// `client ...`, `tool ...`, and either after `as UID`.
fn run_directive(mut r: Run, w: List[str]) {
    var uid = -1
    var at = 0
    if w[0] == "as" {
        uid = w[1].to_int() else -1
        at = 2
    }
    let kind = w[at]
    var argv = List[str]()
    if kind == "client" {
        (mut argv).push("/rows/bin/alpha")
        for k in at + 1..w.len {
            (mut argv).push(w[k])
        }
        (mut argv).push("--control")
        (mut argv).push(control_path(r))
    } else {
        (mut argv).push("/rows/bin/talk")
        for k in at + 1..w.len {
            (mut argv).push(if w[k] == "CONTROL" then control_path(r) else w[k])
        }
    }
    let ran = run_cmd(mut r, argv, uid)
    for l in ran.out.lines() {
        print_said(kind, l)
    }
    for l in ran.err.lines() {
        print("{kind}: (stderr) {normal_any(l)}")
    }
    let who = if uid >= 0 then "as-{uid}-" else ""
    let tool = if kind == "tool" then "tool-" else ""
    let name = fact_name("exit-" + who + tool, w, at + 1)
    print("fact: {name} {ran.status}")
}

// A line a client or tool printed: a fact as it is, else `KIND: LINE`.
fn print_said(kind: str, line: str) {
    if line.starts_with("fact: ") {
        print(line)
    } else {
        print("{kind}: {normal_any(line)}")
    }
}

fn not_fact_line(text: str) -> bool {
    for l in text.lines() {
        if !l.starts_with("fact: ") && text.contains(l + "\n") {
            return true
        }
    }
    false
}

// `bg-start [as UID] tool ARGS...`: the tool runs on, its output read.
fn bg_start(mut r: Run, w: List[str]) {
    if r.bg_slot >= 0 {
        print("rowrun: a background tool already runs")
        return
    }
    var uid = -1
    var at = 1
    if w.len > 2 && w[1] == "as" {
        uid = w[2].to_int() else -1
        at = 3
    }
    if at >= w.len || w[at] != "tool" {
        print("rowrun: bg-start runs a tool")
        return
    }
    var argv = List[str]()
    (mut argv).push("/rows/bin/talk")
    for k in at + 1..w.len {
        (mut argv).push(if w[k] == "CONTROL" then control_path(r) else w[k])
    }
    let o = process.pipe() else |e| {
        print("rowrun: no pipe: {e}")
        return
    }
    let nul = fs.open("/dev/null") else |e| {
        print("rowrun: no /dev/null: {e}")
        return
    }
    var c = process.from_argv(argv)
    process.set_fd(mut c, 0, nul)
    process.set_fd(mut c, 1, o.write)
    let f = process.fork() else |e| {
        print("rowrun: cannot fork: {e}")
        return
    }
    if process.is_child(f) {
        if uid >= 0 {
            process.set_ids(uid, uid, [uid]) else |_| {
                process.exit(125)
            }
        }
        process.exec(c, ["PATH=/usr/bin:/bin", "HOME=/tmp", "SHELL=/bin/sh"]) else |_| {}
        process.exit(127)
    }
    var ow = o.write
    fs.close(take ow) else |_| {}
    var n = nul
    fs.close(take n) else |_| {}
    r.bg_slot = f.child.slot
    r.bg_pid = f.pid
    r.bg_fd = o.read.fd
    r.bg_buf = ""
    let deadline = ms() + r.limit
    while !not_fact_line(r.bg_buf) && ms() < deadline {
        if r.open {
            let _more = pull(mut r, 0)
        }
        let (more, chunk) = read_ready(r.bg_fd, 50)
        r.bg_buf = r.bg_buf + chunk
        if !more {
            break
        }
    }
    if !not_fact_line(r.bg_buf) {
        print("rowrun: the background tool said nothing but facts within {r.limit} ms")
    }
}

fn bg_stop(mut r: Run) {
    if r.bg_slot < 0 {
        print("rowrun: no background tool to stop")
        return
    }
    signal.send(r.bg_pid, signal.terminate()) else |_| {}
    var going = true
    while going {
        if r.open {
            let _more = pull(mut r, 0)
        }
        let (more, chunk) = read_ready(r.bg_fd, 50)
        r.bg_buf = r.bg_buf + chunk
        going = more
    }
    var ch = process.Child { slot: r.bg_slot }
    let _status = process.wait_status(take ch) else 0
    var f = fs.File { fd: r.bg_fd }
    fs.close(take f) else |_| {}
    r.bg_slot = -1
    for l in r.bg_buf.lines() {
        print_said("bg", l)
    }
}

fn watch_start(mut r: Run) {
    var c = process.command("/rows/bin/alpha")
    process.push_arg(mut c, "watch")
    process.push_arg(mut c, "--format=1")
    process.push_arg(mut c, "--control")
    process.push_arg(mut c, control_path(r))
    let o = process.pipe() else |e| {
        print("rowrun: no pipe: {e}")
        return
    }
    process.set_stdout(mut c, o.write)
    let child = process.start(c) else |e| {
        print("rowrun: cannot start the watch: {e}")
        return
    }
    var ow = o.write
    fs.close(take ow) else |_| {}
    r.watch_pid = process.pid(child) else 0
    r.watch = child
    r.watch_pipe = o.read
    r.watching = true
    r.watch_buf = ""
    let deadline = ms() + r.limit
    while !r.watch_buf.contains("\n") && ms() < deadline {
        if r.open {
            let _more = pull(mut r, 0)
        }
        let (more, chunk) = read_ready(r.watch_pipe.fd, 50)
        r.watch_buf = r.watch_buf + chunk
        if !more {
            break
        }
    }
    if !r.watch_buf.contains("\n") {
        print("rowrun: the watch said nothing within {r.limit} ms")
    }
}

fn watch_stop(mut r: Run) {
    if !r.watching {
        print("rowrun: no watch to stop")
        return
    }
    var quiet = 0
    while quiet < 300 {
        if r.open {
            let _more = pull(mut r, 0)
        }
        let (more, chunk) = read_ready(r.watch_pipe.fd, 50)
        if chunk == "" {
            quiet += 50
        } else {
            quiet = 0
            r.watch_buf = r.watch_buf + chunk
        }
        if !more {
            break
        }
    }
    signal.send(r.watch_pid, signal.terminate()) else |_| {}
    var ch = process.Child { slot: r.watch.slot }
    let _status = process.wait_status(take ch) else 0
    var f = fs.File { fd: r.watch_pipe.fd }
    fs.close(take f) else |_| {}
    r.watching = false
    for l in r.watch_buf.lines() {
        print("watch: {normal_json(l)}")
    }
}

fn main() -> int {
    let args = env_args()
    if args.len != 1 {
        eprint("usage: rowrun CASE")
        return 2
    }
    let case = args[0]
    let status = fs.read_text("/proc/self/status") else ""
    let blk = status_field(status, "SigBlk")
    let ign = status_field(status, "SigIgn")
    print("rowrun: container SigBlk {blk} SigIgn {ign}")
    let caps = status_field(status, "CapEff")
    eprint("rowrun: container CapEff {caps}")
    let row = fs.read_text(case + "/row") else |e| {
        print("rowrun: cannot read {case}/row: {e}")
        return 2
    }
    var r = Run {
        case: case,
        pipe: fs.File { fd: -1 },
        open: false,
        buf: "",
        lines: List[str](),
        times: List[int](),
        service: List[str](),
        cursor: 0,
        child: process.Child { slot: -1 },
        has_child: false,
        pid: 0,
        quiet: false,
        rss: 0,
        fds: 0,
        limit: 20000,
        watch: process.Child { slot: -1 },
        watch_pid: 0,
        watch_pipe: fs.File { fd: -1 },
        watching: false,
        watch_buf: "",
        bg_slot: -1,
        bg_pid: 0,
        bg_fd: -1,
        bg_buf: "",
    }
    for line in row.lines() {
        var w = List[str]()
        for x in line.words() {
            (mut w).push(x)
        }
        if w.len == 0 {
            continue
        }
        let verb = w[0]
        if verb == "block" && w.len == 2 {
            let res = sys.mask_block(signal_number(w[1]))
            print("rowrun: block {w[1]}: {res}")
        } else if verb == "ignore" && w.len == 2 {
            var said = "0"
            signal.ignore_one(signal.host(signal_number(w[1]))) else |e| {
                said = "{e}"
            }
            print("rowrun: ignore {w[1]}: {said}")
        } else if verb == "timing" {
            // A mark for tools/check-linux: the row runs again on one CPU.
        } else if verb == "manager" {
            print("rowrun: manager")
            start_manager(mut r)
        } else if verb == "until" {
            until(mut r, rest_of(w, 1))
        } else if verb == "sleep" && w.len == 2 {
            sleep_reading(mut r, w[1].to_int() else 0)
        } else if verb == "term" {
            print("rowrun: term")
            signal.send(r.pid, signal.terminate()) else |e| {
                print("rowrun: cannot send TERM: {e}")
            }
        } else if verb == "signal" && w.len == 3 {
            let pid = pid_of(r, w[1])
            print("rowrun: signal {w[1]} {w[2]}")
            if pid <= 1 {
                print("rowrun: no pid for {w[1]}")
            } else {
                signal.send(pid, signal.host(signal_number(w[2]))) else |e| {
                    print("rowrun: cannot send {w[2]}: {e}")
                }
            }
        } else if verb == "exit" {
            wait_exit(mut r)
        } else if verb == "client" ||
            verb == "tool" ||
            verb == "as" && w.len >= 3 && (w[2] == "client" || w[2] == "tool") {
            run_directive(mut r, w)
        } else if verb == "bg-start" {
            bg_start(mut r, w)
        } else if verb == "bg-stop" {
            bg_stop(mut r)
        } else if verb == "watch-start" {
            watch_start(mut r)
        } else if verb == "watch-stop" {
            watch_stop(mut r)
        } else if verb == "manager-again" {
            let ran = run_cmd(mut r, ["/rows/bin/alpha", "manager", "--root", r.case + "/in"], -1)
            for l in ran.err.lines() {
                print("again: {normal(l)}")
            }
            print("again: exit {ran.status}")
        } else if verb == "limit" && w.len == 2 {
            r.limit = w[1].to_int() else 20000
        } else if verb == "quiet" {
            r.quiet = true
        } else if verb == "zombies" {
            print("fact: zombies {zombies()}")
        } else if verb == "alive" && w.len == 3 {
            print("fact: {w[1]} {running(w[2])}")
        } else if verb == "count" && w.len >= 3 {
            let text = rest_of(w, 2)
            var n = 0
            for l in r.lines {
                if l.contains(text) {
                    n += 1
                }
            }
            print("fact: {w[1]} {n}")
        } else if verb == "gap" {
            gap(r, rest_of(w, 1))
        } else if verb == "fd-mark" {
            r.fds = fewest_fds(mut r)
        } else if verb == "fd-check" {
            let now = fewest_fds(mut r)
            eprint(
                "rowrun: manager descriptors {r.fds} at the mark, {now} now (the fewest of 50 looks)",
            )
            if now > 0 && r.fds > 0 && now <= r.fds + 2 {
                print("fact: fd-growth none")
            } else {
                print("fact: fd-growth {r.fds}-to-{now}")
            }
        } else if verb == "rss-mark" {
            r.rss = rss_of(r.pid)
        } else if verb == "rss-check" && w.len == 2 {
            let pct = w[1].to_int() else 25
            let now = rss_of(r.pid)
            eprint("rowrun: manager VmRSS {r.rss} kB at the mark, {now} kB now")
            if r.rss > 0 && now > 0 && (now - r.rss) * 100 <= r.rss * pct {
                print("fact: rss-growth within-{pct}%")
            } else {
                print("fact: rss-growth {r.rss}kB-to-{now}kB")
            }
        } else {
            print("rowrun: unknown directive '{line}'")
            return 2
        }
    }
    if r.has_child {
        print("rowrun: the row ends with the manager running")
        signal.send(r.pid, signal.kill()) else |_| {}
    }
    0
}
