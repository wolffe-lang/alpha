#!/bin/sh
# Adapted from wolffe-lang/scent ea1b5b19 tools/fetch-toolchain; own code.
# fetch-toolchain: stage the pinned wolf, lupin and std into .wolf-bin/.
#
# The archives come from the GitHub releases and are REFUSED unless their
# sha256 is the one wolf-toolchain.toml names. The std tree is fetched at its
# pinned commit and its git tree id checked against the pin. A stage whose
# recorded pin already matches is left alone, so this is cheap to run before
# every build.
#
# $ALPHA_ARCHIVE_DIR, when set, is a directory the archives are taken from
# instead of the network (a host with a slow link). The digest check is the
# same either way: the pin decides what is acceptable, never where it came
# from.
set -eu
ALPHA_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export ALPHA_ROOT
cd "$ALPHA_ROOT"
. tools/lib-toml.sh

target=$(host_target) || {
    echo "fetch-toolchain: no pinned archive for $(uname -s) $(uname -m)" >&2
    exit 1
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

wolf_digest=$(toml_value wolf "$target")
lupin_digest=$(toml_value lupin "$target")
std_rev=$(toml_value std rev)
std_tree=$(toml_value std tree)
want_stamp="$target wolf=$wolf_digest lupin=$lupin_digest std=$std_rev"

if [ -f .wolf-bin/STAMP ] && [ "$(cat .wolf-bin/STAMP)" = "$want_stamp" ]; then
    echo "fetch-toolchain: .wolf-bin/ already holds the pin ($target)"
    exit 0
fi

mkdir -p "${TMPDIR:-$ALPHA_ROOT/target/tmp}"
tmp=$(mktemp -d "${TMPDIR:-$ALPHA_ROOT/target/tmp}/alpha-toolchain.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
rm -rf .wolf-bin
mkdir -p .wolf-bin

# fetch_archive SECTION NAME-PREFIX DIGEST
fetch_archive() {
    version=$(toml_value "$1" version)
    repo=$(toml_value "$1" repo)
    base="$2-$version-$target"
    if [ -n "${ALPHA_ARCHIVE_DIR:-}" ] && [ -f "$ALPHA_ARCHIVE_DIR/$base.tar.gz" ]; then
        echo "fetch-toolchain: $ALPHA_ARCHIVE_DIR/$base.tar.gz"
        cp "$ALPHA_ARCHIVE_DIR/$base.tar.gz" "$tmp/$base.tar.gz"
    else
        url="https://github.com/$repo/releases/download/v$version/$base.tar.gz"
        echo "fetch-toolchain: $url"
        curl -sSfL --retry 3 --retry-delay 5 -o "$tmp/$base.tar.gz" "$url"
    fi
    have=$(sha256 "$tmp/$base.tar.gz")
    if [ "$have" != "$3" ]; then
        echo "fetch-toolchain: REFUSED: $base.tar.gz has sha256 $have, the pin wants $3" >&2
        exit 1
    fi
    echo "fetch-toolchain: sha256 $have OK"
    tar -xzf "$tmp/$base.tar.gz" -C "$tmp"
    cp -R "$tmp/$base/." .wolf-bin/
}

fetch_archive wolf wolf "$wolf_digest"
fetch_archive lupin lupin "$lupin_digest"

# The wolf archive carries a std/ of its own (std/STD-REV names its commit).
# The pin is unpacked into an empty place, never over that tree: a mix of
# two commits' files is neither. What the archive bundled is said, so a pin
# that has drifted from it is seen.
if [ -d .wolf-bin/std ]; then
    echo "fetch-toolchain: the archive bundles std $(cat .wolf-bin/std/STD-REV 2>/dev/null || echo '(no STD-REV)'); staging the pin instead"
    rm -rf .wolf-bin/std
fi

std_repo=$(toml_value std repo)
echo "fetch-toolchain: https://github.com/$std_repo at $std_rev"
git init -q "$tmp/std"
git -C "$tmp/std" fetch -q --depth 1 "https://github.com/$std_repo" "$std_rev"
have_tree=$(git -C "$tmp/std" rev-parse 'FETCH_HEAD^{tree}')
if [ "$have_tree" != "$std_tree" ]; then
    echo "fetch-toolchain: REFUSED: std $std_rev has tree $have_tree, the pin wants $std_tree" >&2
    exit 1
fi
git -C "$tmp/std" archive FETCH_HEAD std | tar -x -C .wolf-bin/
git -C "$tmp/std" rev-parse FETCH_HEAD >.wolf-bin/std/STD-REV

echo "$want_stamp" >.wolf-bin/STAMP
echo "fetch-toolchain: staged $target into .wolf-bin/"
