#!/usr/bin/env python3
"""check-public-text: tracked text stays public prose.

    tools/check-public-text

alpha is a public repository. Its files, like its commit messages and pull
requests, never carry the names of the private machinery the project is
developed with: work-lane identifiers (two letters and two or three digits
at the start of a word, as "ab12"), decision identifiers ("R-ab12-3"),
build-host names, planning-file paths, or "the maintainer". This reads
every tracked file that is text and prints each hit as `FILE:LINE: what`.
Exit 0 with no hit, 1 otherwise.
"""
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
# The words, each with what it is; matched case-insensitively at word bounds.
RULES = [
    (r"\b[a-z]{2}[0-9]{2,3}[a-z]?-plant\b", "a plant branch name"),
    (r"\bR-[a-z]{1,6}[0-9]{0,3}-[0-9]{1,4}\b", "a decision identifier"),
    (r"\b(?:al|px|pm|pl|sh|ct|vc|wl|tl|cb|yw|sp|gd|rl|sc|wr|bu|fn|lp|cm|tr)[0-9]{2,3}[a-z]?\b", "a work-lane identifier"),
    (r"\b(?:hasu|satoyama|kasumi|nomad|almanta)\b", "a build-host name"),
    (r"\bsprints/|\bHANDOFF\b|\borch-plan|\bcrawl-[0-9]+\b", "a planning path"),
    (r"\bthe maintainer\b", "\"the maintainer\""),
]
# Files whose words are data, not prose: this checker's own rule table.
SKIP = {"tools/check-public-text"}


def tracked():
    out = subprocess.run(["git", "-C", str(ROOT), "ls-files", "-z"], check=True, capture_output=True).stdout
    return [p for p in out.decode("utf-8").split("\0") if p]


def main():
    rules = [(re.compile(rx, re.IGNORECASE), what) for rx, what in RULES]
    hits = files = 0
    for rel in tracked():
        if rel in SKIP:
            continue
        data = (ROOT / rel).read_bytes()
        if b"\0" in data:
            continue
        files += 1
        for number, line in enumerate(data.decode("utf-8", "replace").splitlines(), 1):
            for rx, what in rules:
                m = rx.search(line)
                if m:
                    print("%s:%d: %s: %r" % (rel, number, what, m.group(0)))
                    hits += 1
    print("check-public-text: %d tracked text file(s), %d hit(s)" % (files, hits))
    return 1 if hits or files == 0 else 0


if __name__ == "__main__":
    sys.exit(main())
