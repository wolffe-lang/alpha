#!/usr/bin/env python3
"""check-units: alpha's golden cases, byte for byte, on each built tier.

    tools/check-units [--tier native|release|all] [PREFIX ...]

A case is a directory under tests/unit/ holding a `status` file:

    program  the program to run, built beside alpha in target/<tier>/
             (`machine-run` for the machine's cases); without the file, alpha
    args     the arguments after the program, one per line (an empty file is
             no argument at all); without the file, `check --root in`
    script   for machine-run, the timed events it reads
    in/      a fixture root: files at the paths alpha would find them
    stdout   what alpha must print on standard output (absent: nothing)
    stderr   what alpha must print on standard error (absent: nothing)
    status   alpha's exit status, one line
    toml     for a syntax case, what any TOML reader must make of it
    note     prose for the reader of the case; nothing reads it

The program runs from the case's directory with a fixed environment and no input,
so a case gives the same bytes on every host. Each case prints
`PASS name [tier]` or `FAIL name [tier]: why` at the start of a line, where
the name is the case's path below tests/unit/ (a gauntlet record finds a
planted break by that line). The expected files are written from the
documents, never copied from alpha's output. A corpus with no case, or a
case directory holding a file this list does not name, is a failure.

Then, unless --cases-only: the TOML oracle (tools/check-toml-oracle) on each
tier asked for, the agreement of docs/UNIT-1.md with the schema and the cases
(tools/check-docs), and on Linux the scale row (tools/check-scale) on the
release tier when it was asked for, else the native.
Exit 0 when every case and every leg passes, 1 otherwise.
"""
import argparse
import os
from pathlib import Path
import platform
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
CASES = ROOT / "tests" / "unit"
KNOWN = {"program", "args", "script", "in", "stdout", "stderr", "status", "toml", "note"}
TIMEOUT = 30


def cases(prefixes):
    found = []
    for status in sorted(CASES.rglob("status")):
        case = status.parent
        name = case.relative_to(CASES).as_posix()
        if "/in/" in "/" + name + "/":
            continue
        if prefixes and not any(name == p or name.startswith(p.rstrip("/") + "/") for p in prefixes):
            continue
        found.append((name, case))
    return found


def first_difference(got, want):
    g, w = got.split(b"\n"), want.split(b"\n")
    for i in range(max(len(g), len(w))):
        a = g[i] if i < len(g) else None
        b = w[i] if i < len(w) else None
        if a != b:
            show = lambda x: "(no line)" if x is None else repr(x.decode("utf-8", "replace"))
            return "line %d: got %s, want %s" % (i + 1, show(a), show(b))
    return "the bytes differ"


def run_case(case, tier):
    """-> None when the case passes, else why it does not."""
    stray = sorted(p.name for p in case.iterdir() if p.name not in KNOWN)
    if stray:
        return "unknown file(s) in the case: " + ", ".join(stray)
    try:
        want_status = int((case / "status").read_text().strip())
    except ValueError:
        return "the status file holds no number"
    args_file = case / "args"
    if args_file.exists():
        args = [a for a in args_file.read_text(encoding="utf-8").split("\n") if a != ""]
    else:
        args = ["check", "--root", "in"]
    program_file = case / "program"
    program = program_file.read_text().strip() if program_file.exists() else "alpha"
    binary = ROOT / "target" / tier / program
    if not binary.is_file():
        return "no program at %s (build it with tools/build)" % binary.relative_to(ROOT)
    env = {"PATH": "/usr/bin:/bin", "LC_ALL": "C", "HOME": str(case), "SHELL": "/bin/sh"}
    try:
        r = subprocess.run([str(binary)] + args, cwd=case, env=env, stdin=subprocess.DEVNULL,
                           capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return "no answer in %d s" % TIMEOUT
    for stream, got in (("stdout", r.stdout), ("stderr", r.stderr)):
        path = case / stream
        want = path.read_bytes() if path.exists() else b""
        if got != want:
            return "%s %s" % (stream, first_difference(got, want))
    if r.returncode != want_status:
        return "status %d, want %d" % (r.returncode, want_status)
    return None


def main():
    p = argparse.ArgumentParser(description="alpha's golden cases")
    p.add_argument("--tier", choices=("native", "release", "all"), default="all")
    p.add_argument("--cases-only", action="store_true", help="the golden cases alone, no other leg")
    p.add_argument("prefix", nargs="*")
    a = p.parse_args()
    tiers = ["native", "release"] if a.tier == "all" else [a.tier]
    found = cases(a.prefix)
    if not found:
        print("check-units: no case under %s%s" % (CASES.relative_to(ROOT), " for " + " ".join(a.prefix) if a.prefix else ""))
        return 1
    failed = 0
    for tier in tiers:
        for name, case in found:
            why = run_case(case, tier)
            if why is None:
                print("PASS %s [%s]" % (name, tier))
            else:
                print("FAIL %s [%s]: %s" % (name, tier, why))
                failed += 1
    total = len(found) * len(tiers)
    print("check-units: %d case(s) on %s: %d passed, %d failed" % (len(found), ", ".join(tiers), total - failed, failed))
    legs_failed = 0
    if not a.cases_only and not a.prefix:
        legs = [["check-toml-oracle", "--tier", t] for t in tiers]
        legs.append(["check-docs", "--tier", tiers[0]])
        if platform.system() == "Linux":
            legs.append(["check-scale", "--tier", "release" if "release" in tiers else "native"])
        else:
            print("SKIP leg/check-scale reason=linux-only (this host is %s; the scale row is set on Linux)" % platform.system())
        for leg in legs:
            print("check-units: leg %s" % " ".join(leg), flush=True)
            rc = subprocess.run([sys.executable, "-I", str(ROOT / "tools" / leg[0])] + leg[1:], cwd=ROOT).returncode
            if rc:
                print("FAIL leg/%s [%s]: exit %d" % (leg[0], leg[-1], rc))
                legs_failed += 1
            else:
                print("PASS leg/%s [%s]" % (leg[0], leg[-1]))
    return 1 if failed or legs_failed else 0


if __name__ == "__main__":
    sys.exit(main())
